POSTGRES_DB=subboost
POSTGRES_USER=subboost
POSTGRES_PASSWORD=<choose-a-database-password>
DATABASE_URL=<postgres-connection-string>
ENCRYPTION_KEY=<generate-a-random-key>
JWT_SECRET=<generate-a-random-key>
CRON_SECRET=<generate-a-random-key>
# 站点级访问令牌门禁:设置后全站(管理界面/所有 API)需携带令牌访问,
# 未设置则关闭门禁。浏览器首访用 ?access_token= 输入一次即可换取 cookie;
# 程序化调用请携带 X-Access-Token 请求头。
# 豁免路径:订阅投递 /api/subscriptions/{token}/config.yaml(自带随机令牌)、/api/health/*、/api/cron/*。
# 建议使用 32 字节以上随机串,例如: openssl rand -hex 32
ACCESS_TOKEN=
LOCAL_SETUP_TOKEN=<generate-a-32-byte-random-token>
# 仅开发/测试可显式开启；生产环境即使设置也不会绕过 CRON_SECRET。
ALLOW_UNAUTHENTICATED_CRON=false
# 只有反向代理会清洗并重写 X-Forwarded-For / X-Real-IP 时才设为 true。
TRUST_PROXY_HEADERS=false
APP_URL=http://localhost:3000
SUBBOOST_PORT=3000
