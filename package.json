{
  "name": "subboost-worker-lite",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1"
  },
  "workspaces": [
    "packages/*",
    "worker"
  ],
  "cloudflare": {
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "管理端访问 token，至少 32 位随机串。生成：`node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"`"
      },
      "ENCRYPTION_KEY": {
        "description": "KV 静态加密密钥（AES-256-GCM），至少 32 位随机串。生成：`node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"`。更换后已有源与订阅无法解密，需要重新录入。"
      }
    }
  },
  "scripts": {
    "build": "npm run worker:build",
    "deploy": "SUBBOOST_SKIP_SECRETS=1 npm run worker:deploy",
    "prepare": "npm run worker:build",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.ts --coverage",
    "test:core": "vitest run --config vitest.core.config.ts",
    "lint": "eslint packages worker --max-warnings=0 && npm run check:ui-consistency && npm run check:repo-hygiene && npm run check:version",
    "check:ui-consistency": "node scripts/check-ui-consistency.cjs packages worker",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.cjs",
    "check:version": "node scripts/check-version.cjs",
    "version:set": "node scripts/check-version.cjs --set",
    "worker:dev": "npm --workspace @subboost/worker run dev",
    "worker:dev:ui": "npm --workspace @subboost/worker run dev:ui",
    "worker:build": "npm --workspace @subboost/worker run build",
    "worker:deploy": "npm run worker:build && node scripts/deploy-worker.cjs",
    "worker:deploy:dry-run": "node scripts/deploy-worker.cjs --dry-run",
    "worker:typecheck": "npm --workspace @subboost/worker run typecheck"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.19.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
