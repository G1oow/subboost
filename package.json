{
  "name": "subboost-worker-lite",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "worker"
  ],
  "scripts": {
    "build": "npm run worker:build",
    "prepare": "npm run worker:build",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.ts --coverage",
    "test:core": "vitest run --config vitest.core.config.ts",
    "lint": "eslint packages worker --max-warnings=0 && npm run check:ui-consistency",
    "check:ui-consistency": "node scripts/check-ui-consistency.cjs packages worker",
    "worker:dev": "npm --workspace @subboost/worker run dev",
    "worker:dev:ui": "npm --workspace @subboost/worker run dev:ui",
    "worker:build": "npm --workspace @subboost/worker run build",
    "worker:deploy": "npm --workspace @subboost/worker run deploy",
    "worker:typecheck": "npm --workspace @subboost/worker run typecheck"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.19.4",
    "eslint-config-next": "^16.2.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
