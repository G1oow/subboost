{
  // Cloudflare Worker Lite：仅依赖 Workers + KV 的精简部署形态
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subboost",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sub/*", "/__scheduled"]
  },
  "kv_namespaces": [{ "binding": "SUBBOOST_KV", "id": "42834611908646e0ab13d9ff2ceba85a" }],
  "triggers": { "crons": ["0 */12 * * *"] },
  // 密钥不进仓库：ADMIN_TOKEN / ENCRYPTION_KEY 必须用 `npx wrangler secret put <NAME> --config worker/wrangler.jsonc`
  // 或在 Cloudflare Dashboard → Worker → Settings → Variables and Secrets 里添加为 Secret 类型。
  "vars": { "APP_NAME": "SubBoost Lite" },
  // Cloudflare Workers Builds 的非生产分支执行 `npx wrangler preview`，该命令要求配置里存在 previews 块。
  // 块可以为空；assets、compatibility_date、migrations 等继续留在顶层，不要复制进来。
  // 预览环境不继承顶层 vars / kv_namespaces / secrets：需要可用的预览运行时，在此补充
  // previews.kv_namespaces（指向独立 KV）并执行 `npx wrangler preview base-config secret put <NAME>`。
  "previews": {},
  "observability": { "enabled": true }
}

