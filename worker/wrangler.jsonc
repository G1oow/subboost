{
  // Cloudflare Worker Lite：仅依赖 Workers + KV 的精简部署形态
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subboost-worker-lite",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sub/*", "/__scheduled"]
  },
  "kv_namespaces": [{ "binding": "SUBBOOST_KV", "id": "42834611908646e0ab13d9ff2ceba85a" }],
  "triggers": { "crons": ["0 */12 * * *"] },
    "vars": {
    "ADMIN_TOKEN": "J8yQ*YGX%!Crn$A9ehwaCJyP",
    "APP_NAME": "SubBoost Lite",
    "ENCRYPTION_KEY": "LM^k&q78QF%zYe$!WFUaaNrc"},
  "observability": { "enabled": true }
}

