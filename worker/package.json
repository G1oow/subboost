{
  "name": "@subboost/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "dev:ui": "vite --config ui/vite.config.ts --configLoader runner",
    "build": "vite build --config ui/vite.config.ts --configLoader runner",
    "deploy": "npm run build && wrangler deploy --config ../wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json"
  },
  "dependencies": {
    "@subboost/core": "file:../packages/core",
    "@subboost/server-core": "file:../packages/server-core",
    "@subboost/ui": "file:../packages/ui",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}

