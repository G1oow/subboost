{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@subboost/core": ["../../packages/core/src/index.ts"],
      "@subboost/core/*": ["../../packages/core/src/*"],
      "@subboost/server-core/*": ["../../packages/server-core/src/*"],
      "@subboost/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
